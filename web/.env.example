# AnonReq demo UI. Copy to web/.env.local — Next.js loads that file
# when you run commands from web/. Do not prefix these with NEXT_PUBLIC_.
# Keys are read only inside server route handlers.

# Gateway origin, no credentials in the URL.
# Example: http://localhost:8080
ANONREQ_GATEWAY_URL=http://localhost:8080

# Bearer token for chat, models, and governance routes.
# Must match the gateway process's ANONREQ_API_KEY.
ANONREQ_API_KEY=

# Bearer token for admin and debug routes (anonymize preview, anonymization
# events, audit export). Falls back to ANONREQ_API_KEY when empty.
# On the gateway in PR #5 these routes accept ANONREQ_ADMIN_API_KEY on its
# own. Chat completions still use ANONREQ_API_KEY.
ANONREQ_ADMIN_API_KEY=

# Gateway flag, not read by this UI. Preview stays 404 until the gateway
# process has ANONREQ_DEBUG_PREVIEW_ENABLED=true.
# ANONREQ_DEBUG_PREVIEW_ENABLED=true

# X-AnonReq-Tenant-ID when the form leaves the tenant blank.
# Must exist in the gateway's config/tenants.yaml (seed: default).
ANONREQ_DEFAULT_TENANT=default

# Offline demo. true = fixtures only, the gateway is never called.
# false = always call the gateway.
# unset = mock only when ANONREQ_GATEWAY_URL is empty.
ANONREQ_MOCK=false

# Optional. In mock mode, set to 404 to render the preview placeholder,
# as if POST /v1/debug/anonymize-preview were disabled.
# ANONREQ_MOCK_PREVIEW=404
