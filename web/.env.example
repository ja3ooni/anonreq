# AnonReq demo UI. Copy to web/.env.local — Next.js loads that file
# when you run commands from web/. Do not prefix these with NEXT_PUBLIC_.
# Keys are read only inside server route handlers.

# Gateway origin, no credentials in the URL.
# Example: http://localhost:8080
ANONREQ_GATEWAY_URL=http://localhost:8080

# Bearer token for POST /v1/chat/completions (and other non-admin routes
# such as /v1/models and /health). Must match the gateway's ANONREQ_API_KEY.
# Sending this key to /v1/admin/* or the preview returns 403.
ANONREQ_API_KEY=

# Bearer token for every admin route: /v1/admin/* (events, export,
# config-history) and POST /v1/debug/anonymize-preview.
# Must match the gateway's ANONREQ_ADMIN_API_KEY. Do not reuse the gateway key.
ANONREQ_ADMIN_API_KEY=

# Gateway flag, not read by this UI. Preview stays 404 until the gateway
# process has ANONREQ_DEBUG_PREVIEW_ENABLED=true.
# ANONREQ_DEBUG_PREVIEW_ENABLED=true

# Sent as X-AnonReq-Tenant-ID on chat and on every admin call.
# Must be the caller's tenant in config/tenants.yaml (seed: default).
# A different tenant_id is rejected with 403.
ANONREQ_TENANT_ID=default

# Offline demo. Fixtures run only when this is exactly true.
# An empty ANONREQ_GATEWAY_URL does not turn mock mode on.
# NODE_ENV=production refuses this flag.
ANONREQ_MOCK=false

# Optional. In mock mode, set to 404 to render the preview placeholder,
# as if POST /v1/debug/anonymize-preview were disabled.
# ANONREQ_MOCK_PREVIEW=404

# Host allowlist for /api/* (DNS-rebinding guard). Default: localhost:$PORT and
# 127.0.0.1:$PORT, where PORT is the port the server listens on (the container
# port in Docker). If you remap the host port, e.g. 127.0.0.1:3001:3000, list the
# host side here or every /api call returns 403:
# ANONREQ_ALLOWED_HOSTS=localhost:3001,127.0.0.1:3001
ANONREQ_ALLOWED_HOSTS=

# Optional GlassFlow Rius (OTLP zero-PII traces) & Tares (correlated timeline events)
GLASSFLOW_RIUS_OTLP_ENDPOINT=
GLASSFLOW_RIUS_API_KEY=
GLASSFLOW_TARES_WEBHOOK_URL=
GLASSFLOW_TARES_TOKEN=

# Staff-chat pilot (/[locale]/staff). Server-side, read per request.
# Admin context: shows the staff view's audit export link and unlocks every /api/audit/*
# route (403 while off). No login in this demo.
ANONREQ_UI_ADMIN=false
# Optional shared secret: when set, /api/audit/* also requires HTTP Basic auth with
# this value as the password (any user name).
# ANONREQ_UI_ADMIN_TOKEN=
# Locale bundles the gateway ships (no gateway endpoint lists them). Default:
# ar,de-DE,en,es,fr-FR,it-IT,nl-NL,pt-BR. Add bg once config/locales/bg.yaml exists.
# ANONREQ_GATEWAY_LOCALES=
# BgGPT model alias. Unset = placeholder "bggpt" (not confirmed by DevOps yet).
# ANONREQ_BGGPT_ALIAS=bggpt
