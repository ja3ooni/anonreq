code: bg-BG
metadata:
  name: Bulgarian
  version: 1
  maintainer: "AnonReq Core"
# No Bulgarian NER model: structured identifiers only. Recorded on the
# audit event and returned as X-AnonReq-NER-Coverage.
ner_coverage: structured_only
# Bulgarian identifiers. Checksum-valid matches use the plain type
# (EGN, LNCH, EIK, IBAN_BG). Format matches that fail the checksum are
# masked as *_UNVERIFIED at 0.6 (fail closed); for the 10- and 9-digit
# shapes that needs a context word (ЕГН, ЛНЧ, ЕИК, БУЛСТАТ) or, for EGN,
# a plausible encoded birth date, so plain order numbers stay readable.
# Context patterns are generated lookbehinds: one per label and separator
# (" ", ":", ": ", " № ", "-", ...), all case-insensitive.
# Names and addresses are out of scope: there is no Bulgarian spaCy
# pipeline, so bg-BG requests use the English Presidio fallback for NER.
entity_types:
  # EGN (ЕГН): YYMMDD (+20 months for 1800s, +40 for 2000s), 3-digit
  # serial, weighted mod-11 check digit. Validated before overlap
  # resolution, so only checksum- and date-valid numbers are EGN.
  - name: EGN
    tier: REGEX
    confidence_threshold: 0.9
    reversible: true
    patterns:
      - '(?<![\w/+-])(?<!\d[.,])\d{10}(?![\w/-]|[.,]\d)'
  # LNCh (ЛНЧ): 10 digits, weights 21,19,17,13,11,9,7,3,1 mod 10.
  - name: LNCH
    tier: REGEX
    confidence_threshold: 0.9
    reversible: true
    patterns:
      - '(?<![\w/+-])(?<!\d[.,])\d{10}(?![\w/-]|[.,]\d)'
  # EIK / BULSTAT (ЕИК / БУЛСТАТ): 9 digits, or 13 for a branch, with an
  # optional BG VAT prefix (BG175074752).
  - name: EIK
    tier: REGEX
    confidence_threshold: 0.9
    reversible: true
    patterns:
      - '(?<![\w/+-])(?<!\d[.,])(?:BG)?\d{9}(?:\d{4})?(?![\w/-]|[.,]\d)'
  # Bulgarian IBAN: BGkk + 4-letter bank code + 4-digit branch + 2-digit
  # account type + 8 alphanumerics (22 characters), MOD-97.
  - name: IBAN_BG
    tier: REGEX
    confidence_threshold: 0.95
    reversible: true
    patterns:
      - '(?<![\w-])BG\d{2}(?:\s?[A-Z]){4}(?:\s?\d){6}(?:\s?[A-Z0-9]){8}(?![\w-])'
  # Bulgarian ID card (лична карта): 9 digits on cards issued before
  # 17 June 2024, 2 letters + 7 digits on the current card. There is no
  # public checksum, so the number is matched only after a context word.
  - name: BG_ID_CARD
    tier: REGEX
    confidence_threshold: 0.85
    reversible: true
    patterns:
      - {{ID_CTX}}
  # +359 / 00359 international and 0-prefixed national numbers: mobile
  # 87/88/89/98/99 (9-digit NSN), Sofia 2 and other area codes (8 digits).
  - name: PHONE_BG
    tier: REGEX
    confidence_threshold: 0.8
    reversible: true
    patterns:
      - '(?<![\w+./-])(?:\+|00)359[\s./-]?(?:\(0\)[\s./-]?)?(?:(?:8[789]|9[89])(?:[\s./-]?\d){7}|[2-9](?:[\s./-]?\d){7})(?![\w.-]*\d)'
      - '(?<![\w+./-])\(?0(?:8[789]|9[89])\)?\d?(?:[\s./-]?\d){6,7}(?![\w.-]*\d)'
      - '(?<![\w+./-])\(?0[2-9]\)?(?:[\s./-]?\d){7}(?![\w.-]*\d)'
      - '(?<![\w+./-])\(?0[3-9]\d{1,3}\)?(?:[\s./-]?\d){4,6}(?![\w.-]*\d)'
      # Mobile number without the trunk 0, only after тел. / GSM / мобилен.
      - {{PHONE_CTX}}
  # Format-only matches that failed the checksum.
  - name: EGN_UNVERIFIED
    tier: REGEX
    confidence_threshold: 0.6
    reversible: true
    patterns:
      # Plausible birth date of a living person: month 01-12 (1900s) or
      # 41-52 (2000s), day 01-31. The 1800s offset (21-32) is left out so
      # year-prefixed numbers such as 2024031512 are not read as EGNs.
      - '(?<![\w/+-])(?<!\d[.,])\d{2}(?:0[1-9]|1[0-2]|4[1-9]|5[0-2])(?:0[1-9]|[12]\d|3[01])\d{4}(?![\w/-]|[.,]\d)'
      - {{EGN_CTX}}
  - name: LNCH_UNVERIFIED
    tier: REGEX
    confidence_threshold: 0.6
    reversible: true
    patterns:
      - {{LNCH_CTX}}
  - name: EIK_UNVERIFIED
    tier: REGEX
    confidence_threshold: 0.6
    reversible: true
    patterns:
      - {{EIK_CTX}}
  - name: IBAN_BG_UNVERIFIED
    tier: REGEX
    confidence_threshold: 0.6
    reversible: true
    patterns:
      # Any case, any checksum. Order codes without the BGkk + bank-code
      # shape do not match.
      - '(?i:(?<![\w-])BG\d{2}(?:\s?[A-Z]){4}(?:\s?\d){6}(?:\s?[A-Z0-9]){8}(?![\w-]))'
  - name: API_KEY
    tier: REGEX
    confidence_threshold: 0.95
    reversible: false
    patterns:
      - '\bsk-[a-zA-Z0-9_-]{20,}\b'
      - '\bAKIA[0-9A-Z]{16}\b'
      - '\bghp_[a-zA-Z0-9]{36}\b'
checksums:
  - algorithm: egn_mod11
    validator_id: EGN
  - algorithm: lnch_mod10
    validator_id: LNCH
  - algorithm: eik_bulstat_mod11
    validator_id: EIK
  - algorithm: iban_mod97
    validator_id: IBAN_BG
