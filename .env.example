# AnonReq Environment Configuration
# Copy to .env and fill in your values
# All variables prefixed with ANONREQ_ are loaded by Pydantic Settings

# ─── Required ────────────────────────────────────────────────────────────────
ANONREQ_API_KEY=<generate-a-secure-32-char-key>
ANONREQ_VALKEY_URL=redis://valkey:6379/0
ANONREQ_PRESIDIO_URL=http://presidio-analyzer:3000
# ISO 639-1 languages this analyzer can run. Default is English.
# Demo compose sets en,de because the image also loads de_core_news_lg.
# Other negotiated locales (fr, es, ar, ...) are analyzed as en.
# ANONREQ_PRESIDIO_LANGUAGES=en

# ─── Provider ────────────────────────────────────────────────────────────────
# Upstream model credential. Required for every configured provider that
# needs a key (config/model_aliases.yaml). Not required for mock, local,
# or ollama. This is NOT the gateway client key — never copy ANONREQ_API_KEY.
# Startup refuses to boot when a keyed provider has no credential.
PROVIDER_API_KEY=<your-provider-api-key>
PROVIDER_BASE_URL=https://api.openai.com
# OpenAI accepts PROVIDER_API_KEY when the variables below are unset.
# Anthropic and Gemini have no shared fallback; set them while the smart
# and gemini-pro aliases remain configured (or remove those aliases).
ANONREQ_OPENAI_API_KEY=
ANONREQ_ANTHROPIC_API_KEY=<your-anthropic-api-key>
ANONREQ_GEMINI_API_KEY=<your-gemini-api-key>

# ─── Server ──────────────────────────────────────────────────────────────────
ANONREQ_HOST=0.0.0.0
ANONREQ_PORT=8080
ANONREQ_LOG_LEVEL=INFO
ANONREQ_REQUEST_TIMEOUT_SECONDS=30
ANONREQ_PRESIDIO_MAX_CONCURRENCY=10
ANONREQ_CACHE_TTL_SECONDS=300

# ─── Policy & Classification ────────────────────────────────────────────────
ANONREQ_POLICY_CONFIG_PATH=config/enterprise-policy.yaml
# Germany beachhead: set to "germany" (GDPR + DE national IDs). Empty = no extra preset.
ANONREQ_ACTIVE_PRESETS=

# ─── Database ────────────────────────────────────────────────────────────────
ANONREQ_DATABASE_URL=sqlite+aiosqlite:///./anonreq.db

# ─── Audit Chain ─────────────────────────────────────────────────────────────
ANONREQ_ANCHOR_SIGNING_KEY=

# ─── Admin API ───────────────────────────────────────────────────────────────
# If unset, POST /v1/admin/config/rules returns 401 (D-151).
ANONREQ_ADMIN_API_KEY=
# Tenant the admin key is bound to. Required when ANONREQ_ADMIN_API_KEY is
# set (startup fails otherwise). A mismatched X-AnonReq-Tenant-ID gets 403.
ANONREQ_ADMIN_TENANT_ID=
ANONREQ_ADMIN_ROLE=administrator

# ─── OIDC Authentication ────────────────────────────────────────────────────
# If all three are set, OIDC JWT validation is enabled for admin endpoints,
# and the legacy ANONREQ_ADMIN_API_KEY is refused (401) on governance routes.
ANONREQ_OIDC_ISSUER=
ANONREQ_OIDC_AUDIENCE=
ANONREQ_OIDC_JWKS_URL=
ANONREQ_OIDC_ROLE_CLAIM=role
ANONREQ_OIDC_JWKS_CACHE_SECONDS=300

# ─── mTLS ────────────────────────────────────────────────────────────────────
ANONREQ_MTLS_ENFORCE=false
ANONREQ_MTLS_TRUSTED_PROXY_CIDRS=
ANONREQ_MTLS_FORWARD_CERT_HEADER=X-Forwarded-Client-Cert

# ─── Secret Backend ──────────────────────────────────────────────────────────
# Options: vault | volume | file. "vault" without VAULT_ADDR/VAULT_TOKEN falls
# back to PROVIDER_API_KEY from env (what the local/demo stack uses).
ANONREQ_SECRET_BACKEND=vault
ANONREQ_SECRET_BACKEND_PATH=anonreq/provider-api-keys
ANONREQ_SECRET_VOLUME_DIR=config/secrets
ANONREQ_SECRET_VOLUME_FILE=provider-api-keys.json

# ─── License (Appliance tier) ───────────────────────────────────────────────
ANONREQ_LICENSE_SECRET=
ANONREQ_LICENSE_KEY=

# ─── Multi-Tenant (Phase 31) ────────────────────────────────────────────────
ANONREQ_TENANTS_CONFIG_PATH=config/tenants.yaml
# Explicit single-tenant mode. When false (default), a missing tenant
# context fails secure with HTTP 503 instead of falling back to "default".
ANONREQ_SINGLE_TENANT=false
ANONREQ_KMS_BACKEND=local
# Optional in development (ephemeral key generated). REQUIRED when ANONREQ_ENV=demo:
# the gateway refuses to start without it. `make demo` generates one into .env.
ANONREQ_KMS_MASTER_KEY=<generate-32+-char-random-key>

# ─── Metrics ──────────────────────────────────────────────────────────────────
# Require auth on /metrics by default. Set to true ONLY for
# Prometheus-behind-sidecar topologies (secured at network level).
ANONREQ_METRICS_NO_AUTH=false

# ─── Environment ──────────────────────────────────────────────────────────────
# development | demo | production. demo requires ANONREQ_KMS_MASTER_KEY.
# Set to production to refuse boot with unset/default credentials.
ANONREQ_ENV=development

# ─── Metrics Cardinality (Phase 31) ─────────────────────────────────────────
ANONREQ_METRICS_MAX_TENANTS=100

# ─── Proxy ───────────────────────────────────────────────────────────────────
ANONREQ_PROXY_MODE=proxy-only
ANONREQ_CA_DIR=./data/ca

# ─── Docker Compose: PostgreSQL ─────────────────────────────────────────────
POSTGRES_USER=<set-secure-postgres-user>
POSTGRES_PASSWORD=<set-secure-postgres-password>
POSTGRES_DB=anonreq

# ─── Docker Compose: MinIO ──────────────────────────────────────────────────
MINIO_ROOT_USER=<set-secure-minio-user>
MINIO_ROOT_PASSWORD=<set-secure-minio-password>
MINIO_ENDPOINT=localhost:9000
MINIO_SECURE=false

# ─── xAI demo (docker-compose.demo.yml / make demo) ─────────────────────────
XAI_API_KEY=<your-xai-api-key>
# Base URL WITHOUT /v1 (gateway appends /v1/chat/completions)
XAI_BASE_URL=https://api.x.ai
ANONREQ_DEMO_MODEL=grok-4
